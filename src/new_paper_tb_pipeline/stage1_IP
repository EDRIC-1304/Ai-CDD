import os
import cv2
from tqdm import tqdm

# ============================================================
# CONFIG
# ============================================================

IMG_SIZE = 224

# ============================================================
# CLASSIFICATION DATASET
# ============================================================

CLASSIFICATION_INPUT = r"G:\Ai-CDD\data\raw\dataset"

CLASSIFICATION_OUTPUT = (
    r"G:\Ai-CDD\data\preprocessed\classification_stage1"
)

# ============================================================
# SEGMENTATION DATASET
# ============================================================

SEGMENTATION_INPUT = (
    r"G:\Ai-CDD\data\segmentation\TBX11K_segmentation dataset"
    r"\tbx11k-simplified\images"
)

SEGMENTATION_OUTPUT = (
    r"G:\Ai-CDD\data\preprocessed\segmentation\images_stage1"
)

# ============================================================
# CREATE OUTPUT DIRECTORIES
# ============================================================

os.makedirs(CLASSIFICATION_OUTPUT, exist_ok=True)
os.makedirs(SEGMENTATION_OUTPUT, exist_ok=True)

# ============================================================
# CLAHE
# ============================================================

def apply_clahe(image):

    clahe = cv2.createCLAHE(
        clipLimit=2.0,
        tileGridSize=(8, 8)
    )

    return clahe.apply(image)

# ============================================================
# PREPROCESS SINGLE IMAGE
# ============================================================

def preprocess_image(image_path):

    # ========================================================
    # LOAD IMAGE
    # ========================================================

    image = cv2.imread(
        image_path,
        cv2.IMREAD_GRAYSCALE
    )

    if image is None:
        return None

    # ========================================================
    # RESIZE
    # ========================================================

    image = cv2.resize(
        image,
        (IMG_SIZE, IMG_SIZE)
    )

    # ========================================================
    # CLAHE ENHANCEMENT
    # ========================================================

    image = apply_clahe(image)

    return image

# ============================================================
# PROCESS CLASSIFICATION DATASET
# ============================================================

def process_classification_dataset():

    for split in ["train", "val", "test"]:

        split_input = os.path.join(
            CLASSIFICATION_INPUT,
            split
        )

        split_output = os.path.join(
            CLASSIFICATION_OUTPUT,
            split
        )

        os.makedirs(split_output, exist_ok=True)

        # ====================================================
        # LOOP THROUGH CLASSES
        # ====================================================

        for cls in os.listdir(split_input):

            class_input = os.path.join(
                split_input,
                cls
            )

            class_output = os.path.join(
                split_output,
                cls
            )

            os.makedirs(class_output, exist_ok=True)

            images = os.listdir(class_input)

            print(f"\nProcessing {split}/{cls}...")

            for img_name in tqdm(images):

                img_path = os.path.join(
                    class_input,
                    img_name
                )

                processed = preprocess_image(img_path)

                if processed is None:
                    continue

                save_path = os.path.join(
                    class_output,
                    img_name
                )

                cv2.imwrite(save_path, processed)

# ============================================================
# PROCESS SEGMENTATION DATASET
# ============================================================

def process_segmentation_dataset():

    images = os.listdir(SEGMENTATION_INPUT)

    print("\nProcessing segmentation dataset...")

    for img_name in tqdm(images):

        img_path = os.path.join(
            SEGMENTATION_INPUT,
            img_name
        )

        processed = preprocess_image(img_path)

        if processed is None:
            continue

        save_path = os.path.join(
            SEGMENTATION_OUTPUT,
            img_name
        )

        cv2.imwrite(save_path, processed)

# ============================================================
# MAIN
# ============================================================

if __name__ == "__main__":

    print("\nStarting preprocessing...\n")

    # ========================================================
    # CLASSIFICATION DATASET
    # ========================================================

    process_classification_dataset()

    # ========================================================
    # SEGMENTATION DATASET
    # ========================================================

    process_segmentation_dataset()

    print("\nPreprocessing completed successfully.")